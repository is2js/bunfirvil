{
  "name": "bunfirvil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "분당 퍼스트빌리지 RPG 렌더링 및 로컬 검수 데모",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "preview:commit": "pwsh -NoProfile -File scripts/preview-committed-pages.ps1",
    "sync:assets": "pwsh -NoProfile -File scripts/sync-from-pvp.ps1",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:smoke": "playwright test",
    "test:smoke:ci": "playwright test tests/e2e/ci-smoke.spec.ts",
    "verify:dist": "node scripts/verify-dist.mjs",
    "validate": "npm run test:unit && npm run build && npm run verify:dist"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.17.2",
    "@types/three": "^0.179.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
